{
  "name": "QuantumVault",
  "version": "2.1.2",
  "type": "module",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "qv": "./bin/qv.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/third-party/",
    "docs/cli.md",
    "docs/schema/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "cli": "node bin/qv.mjs",
    "test:core": "node --test tests/core/*.test.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "test:parity": "node --test tests/parity/*.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "cli:selftest": "node scripts/cli-selftest.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "schema:fixtures": "node scripts/schema-fixtures.mjs",
    "corpus:verify": "node scripts/corpus-verify.mjs",
    "check": "npm run test:cli && npm run test:parity && npm run selftest && npm run cli:selftest && npm run schema:fixtures && npm run corpus:verify && npm run build",
    "release:check": "npm run check && npm run test:browser",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1"
  }
}
